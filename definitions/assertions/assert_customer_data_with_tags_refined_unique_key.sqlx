config {
  type: "assertion",
  name: "assert_customer_data_with_tags_refined_unique_key",
  description: "Uniqueness check for customer_data_with_tags_refined (Customer_Id) -- all data quality checks are generated as standalone assertion files."
}

SELECT Customer_Id, COUNT(*) AS row_count
FROM ${ref("customer_data_with_tags_refined")}
GROUP BY Customer_Id
HAVING COUNT(*) > 1
