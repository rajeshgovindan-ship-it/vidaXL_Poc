config {
  type: "assertion",
  name: "assert_raw_customers_refined_unique_key",
  description: "Uniqueness check for raw_customers_refined (customer_id) -- all data quality checks are generated as standalone assertion files."
}

SELECT customer_id, COUNT(*) AS row_count
FROM ${ref("raw_customers_refined")}
GROUP BY customer_id
HAVING COUNT(*) > 1
