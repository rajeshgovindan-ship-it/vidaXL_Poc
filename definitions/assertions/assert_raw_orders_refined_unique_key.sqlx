config {
  type: "assertion",
  name: "assert_raw_orders_refined_unique_key",
  description: "Uniqueness check for raw_orders_refined (order_id) -- all data quality checks are generated as standalone assertion files."
}

SELECT order_id, COUNT(*) AS row_count
FROM ${ref("raw_orders_refined")}
GROUP BY order_id
HAVING COUNT(*) > 1
