config {
  type: "assertion",
  name: "orders_data_refined_unique_key",
  description: "Uniqueness check for orders_data_refined (order_id) -- operations-type table, config.assertions.uniqueKey is not supported inline, see build_standalone_assertion_files."
}

SELECT order_id, COUNT(*) AS row_count
FROM ${ref("orders_data_refined")}
GROUP BY order_id
HAVING COUNT(*) > 1
