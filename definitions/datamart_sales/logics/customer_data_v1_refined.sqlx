  WHERE account_balance >= 0
),
orders_aggregated AS (
  SELECT
    orders_data.order_id AS order_id,
    orders_data.uid AS uid,
    SUM(amount) AS total_order_amount,
    AVG(amount) AS average_order_amount,
    COUNT(*) AS order_count
  FROM ${ref("orders_data")} AS orders_data
  WHERE status = 'COMPLETED' AND COALESCE(o.total_order_amount, 0) AS total_order_amount AND COALESCE(o.average_order_amount, 0) AS average_order_amount AND COALESCE(o.order_count, 0) AS order_count
  GROUP BY orders_data.order_id, orders_data.uid
)
SELECT
  customer_base.customer_id AS customer_id,
  orders_aggregated.order_id AS order_id,
  customer_base.customer_name AS customer_name,
  customer_base.signup_timestamp AS signup_timestamp,
  customer_base.account_balance AS account_balance,
  orders_aggregated.uid AS uid,
  orders_aggregated.total_order_amount AS total_order_amount,
  orders_aggregated.average_order_amount AS average_order_amount,
  orders_aggregated.order_count AS order_count
FROM customer_base AS customer_base
LEFT JOIN orders_aggregated AS orders_aggregated ON CAST(customer_base.customer_id AS STRING) = orders_aggregated.uid
