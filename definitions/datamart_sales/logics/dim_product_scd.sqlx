config {
  type: "operations",
  hasOutput: 'true',
  schema: "gold_sales",
  tags: ["datamart_sales", "dim_product_scd", "gold", "daily"],
  description: "Product dimension, SCD1 upsert."
}


-- Step 1: Ensure target table exists
CREATE TABLE IF NOT EXISTS `gcp-accelerator-380712.gold_sales.dim_product_scd`
OPTIONS(description='''Product dimension, SCD1 upsert.''')
AS
SELECT * FROM (SELECT
  product_raw.product_id AS product_id,
  product_raw.product_name AS product_name,
  product_raw.category AS category
FROM ${ref("product_raw")} AS product_raw) LIMIT 0;

-- Step 2: Upsert (only rewrites rows that actually changed)
MERGE `gcp-accelerator-380712.gold_sales.dim_product_scd` T
USING (SELECT
  product_raw.product_id AS product_id,
  product_raw.product_name AS product_name,
  product_raw.category AS category
FROM ${ref("product_raw")} AS product_raw) S
ON T.product_id = S.product_id
WHEN MATCHED AND (T.product_name IS DISTINCT FROM S.product_name OR T.category IS DISTINCT FROM S.category) THEN
  UPDATE SET T.product_name = S.product_name, T.category = S.category
WHEN NOT MATCHED THEN
  INSERT (product_id, product_name, category) VALUES (S.product_id, S.product_name, S.category)
