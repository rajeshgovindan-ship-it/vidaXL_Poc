-- Generated by Tiger Data Fabric (Dataform edition)
-- Target: gcp-accelerator-380712.gold_sales.vw_customer_summary
-- Tags: datamart_sales, vw_customer_summary, gold, daily
-- Idempotent via ${ref()} + Dataform incremental/operations semantics
config {
  type: "view",
  schema: "gold_sales",
  tags: ["datamart_sales", "vw_customer_summary", "gold", "daily"],
  columns: {
    total_spend: "Calculation: SUM(amount)"
  },
  description: "Customer summary view."
}

WITH cust_totals AS (
  SELECT
    orders_raw.customer_id AS customer_id,
    SUM(amount) AS total_spend,
    customer_data_v1.country AS country
  FROM ${ref("orders_raw")} AS orders_raw
  LEFT JOIN ${ref("customer_data_v1")} AS customer_data_v1 ON orders_raw.customer_id = customer_data_v1.customer_id
  GROUP BY orders_raw.customer_id, customer_data_v1.country
)
SELECT
  cust_totals.customer_id AS customer_id,
  cust_totals.country AS country,
  cust_totals.total_spend AS total_spend,
  DENSE_RANK() OVER (PARTITION BY country ORDER BY total_spend DESC) AS spend_rank_in_country
FROM cust_totals AS cust_totals
ORDER BY total_spend DESC
