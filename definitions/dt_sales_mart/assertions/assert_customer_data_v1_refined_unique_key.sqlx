config {
  type: "assertion",
  name: "assert_customer_data_v1_refined_unique_key",
  description: "Uniqueness check for customer_data_v1_refined (customer_id, Index, order_id) -- all data quality checks are generated as standalone assertion files."
}

SELECT customer_id, Index, order_id, COUNT(*) AS row_count
FROM ${ref("customer_data_v1_refined")}
GROUP BY customer_id, Index, order_id
HAVING COUNT(*) > 1
