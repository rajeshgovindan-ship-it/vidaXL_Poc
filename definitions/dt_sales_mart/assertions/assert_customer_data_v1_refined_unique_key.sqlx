config {
  type: "assertion",
  name: "assert_customer_data_v1_refined_unique_key",
  description: "Uniqueness check for customer_data_v1_refined (Index, order_id) -- all data quality checks are generated as standalone assertion files."
}

SELECT Index, order_id, COUNT(*) AS row_count
FROM ${ref("customer_data_v1_refined")}
GROUP BY Index, order_id
HAVING COUNT(*) > 1
