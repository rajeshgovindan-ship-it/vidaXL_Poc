config {
  type: "assertion",
  name: "assert_dim_customer_master_unique_key",
  schema: "gold_assertions",
  description: "Uniqueness check for dim_customer_master (customer_id) -- all data quality checks are generated as standalone assertion files."
}

SELECT customer_id, COUNT(*) AS row_count
FROM ${ref("dim_customer_master")}
GROUP BY customer_id
HAVING COUNT(*) > 1
