config {
  type: "assertion",
  name: "assert_dim_customer_scd1_unique_key",
  schema: "gold_assertions",
  description: "Uniqueness check for dim_customer_scd1 (customer_id) -- all data quality checks are generated as standalone assertion files."
}

SELECT customer_id, COUNT(*) AS row_count
FROM ${ref("dim_customer_scd1")}
GROUP BY customer_id
HAVING COUNT(*) > 1
