config {
  type: "assertion",
  name: "assert_fct_orders_incremental_unique_key",
  schema: "gold_assertions",
  description: "Uniqueness check for fct_orders_incremental (order_id, order_date) -- all data quality checks are generated as standalone assertion files."
}

SELECT order_id, order_date, COUNT(*) AS row_count
FROM ${ref("fct_orders_incremental")}
GROUP BY order_id, order_date
HAVING COUNT(*) > 1
