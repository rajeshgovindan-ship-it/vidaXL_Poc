config {
  type: "assertion",
  name: "assert_tc1_dim_customer_unique_key",
  schema: "gold_assertions",
  description: "Uniqueness check for tc1_dim_customer (customer_id) -- all data quality checks are generated as standalone assertion files."
}

SELECT customer_id, COUNT(*) AS row_count
FROM ${ref("tc1_dim_customer")}
GROUP BY customer_id
HAVING COUNT(*) > 1
