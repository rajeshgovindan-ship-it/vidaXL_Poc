config {
  type: "assertion",
  name: "assert_tc3_customer_freshness_freshness",
  schema: "gold_assertions",
  description: "Freshness check for tc3_customer_freshness.signup_timestamp -- fails if the most recent value is more than 7 day(s) old, catching a pipeline that has silently stopped updating."
}

SELECT MAX(signup_timestamp) AS most_recent_value
FROM ${ref("tc3_customer_freshness")}
HAVING CAST(MAX(signup_timestamp) AS TIMESTAMP) < TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 7 DAY)
