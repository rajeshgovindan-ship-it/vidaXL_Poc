config {
  type: "assertion",
  name: "assert_tc4_customer_tags_fk_referential_Customer_Id",
  description: "Referential integrity check: every non-null tc4_customer_tags_fk.Customer_Id must exist in gcp-accelerator-380712.gold.tc1_dim_customer.customer_id -- catches orphaned foreign key values."
}

SELECT t.Customer_Id
FROM ${ref("tc4_customer_tags_fk")} AS t
WHERE t.Customer_Id IS NOT NULL
  AND t.Customer_Id NOT IN (SELECT customer_id FROM ${ref("tc1_dim_customer")})
