config {
  type: "assertion",
  name: "assert_tc5_orders_volume_volume",
  schema: "gold_assertions",
  description: "Volume check for tc5_orders_volume -- fails if the most recent order_date loaded fewer than 50% of the average rows per period over the preceding 7. Catches a load that ran 'successfully' but produced far less data than normal."
}

WITH per_period AS (
  SELECT order_date AS p, COUNT(*) AS n
  FROM ${ref("tc5_orders_volume")}
  GROUP BY order_date
),
latest AS (SELECT MAX(p) AS p FROM per_period),
baseline AS (
  SELECT AVG(n) AS avg_n FROM per_period
  WHERE p < (SELECT p FROM latest)
    AND p >= DATE_SUB((SELECT p FROM latest), INTERVAL 7 DAY)
)
SELECT pp.p AS period, pp.n AS row_count, b.avg_n AS baseline_avg
FROM per_period pp, latest l, baseline b
WHERE pp.p = l.p AND b.avg_n IS NOT NULL AND pp.n < 0.5 * b.avg_n
