}


-- Step 1: Ensure target table exists
CREATE TABLE IF NOT EXISTS `gcp-accelerator-380712.gold.dim_customer_cdc`
OPTIONS(description='''CDC: MERGE upsert from a change-event source -- same MERGE mechanics as SCD1.''')
AS
SELECT * FROM (SELECT
  customer_data_v1.customer_id AS customer_id,
  customer_data_v1.customer_name AS customer_name
FROM ${ref("customer_data_v1")} AS customer_data_v1) LIMIT 0;

-- Step 2: Upsert (only rewrites rows that actually changed)
MERGE `gcp-accelerator-380712.gold.dim_customer_cdc` T
USING (SELECT
  customer_data_v1.customer_id AS customer_id,
  customer_data_v1.customer_name AS customer_name
FROM ${ref("customer_data_v1")} AS customer_data_v1) S
ON T.customer_id = S.customer_id
WHEN MATCHED AND (T.customer_name IS DISTINCT FROM S.customer_name) THEN
  UPDATE SET T.customer_name = S.customer_name
WHEN NOT MATCHED THEN
  INSERT (customer_id, customer_name) VALUES (S.customer_id, S.customer_name)
