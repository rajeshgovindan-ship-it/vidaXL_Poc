config {
  type: "operations",
  hasOutput: true,
  schema: "gold",
  tags: ["dt_sales_mart", "dim_customer_cdc", "gold", "daily"],
  columns: {
    "customer_id": "Customer id -- MERGE key.",
    "customer_name": "Name."
