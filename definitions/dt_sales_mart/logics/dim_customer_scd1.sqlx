-- Step 1: Ensure target table exists
CREATE TABLE IF NOT EXISTS `gcp-accelerator-380712.gold.dim_customer_scd1`
OPTIONS(description='''SCD1: MERGE upsert on primary key -- always shows the CURRENT value, no history retained.''')
AS
SELECT * FROM (SELECT
  customer_data_v1.customer_id AS customer_id,
  customer_data_v1.account_balance AS account_balance
FROM ${ref("customer_data_v1")} AS customer_data_v1) LIMIT 0;

-- Step 2: Upsert (only rewrites rows that actually changed)
MERGE `gcp-accelerator-380712.gold.dim_customer_scd1` T
USING (SELECT
  customer_data_v1.customer_id AS customer_id,
  customer_data_v1.account_balance AS account_balance
FROM ${ref("customer_data_v1")} AS customer_data_v1) S
ON T.customer_id = S.customer_id
WHEN MATCHED AND (T.account_balance IS DISTINCT FROM S.account_balance) THEN
  UPDATE SET T.account_balance = S.account_balance
WHEN NOT MATCHED THEN
  INSERT (customer_id, account_balance) VALUES (S.customer_id, S.account_balance)
