-- Idempotent via ${ref()} + Dataform incremental/operations semantics
config {
  type: "operations",
  hasOutput: true,
  schema: "gold",
  tags: ["dt_sales_mart", "dim_customer_scd2", "gold", "daily"],
  columns: {
    "customer_id": "Customer id -- MERGE key.",
    "account_balance": "Balance -- a NEW version row is inserted when this changes.",
    "from_date": "SCD2: date this version became current. -- Calculation: CURRENT_DATE()",
    "to_date": "SCD2: date this version was superseded; NULL = current. -- Calculation: CAST(NULL AS DATE)",
    "is_current": "SCD2: TRUE for the live version of the row. -- Calculation: TRUE"
  },
  description: "SCD2: keeps every historical version. from_date/to_date/is_current added automatically."
}


-- Step 1: Ensure target table exists
CREATE TABLE IF NOT EXISTS `gcp-accelerator-380712.gold.dim_customer_scd2`
OPTIONS(description='''SCD2: keeps every historical version. from_date/to_date/is_current added automatically.''')
AS
SELECT * FROM (SELECT
  customer_data_v1.customer_id AS customer_id,
  customer_data_v1.account_balance AS account_balance,
  CURRENT_DATE() AS from_date,
  CAST(NULL AS DATE) AS to_date,
  TRUE AS is_current
FROM ${ref("customer_data_v1")} AS customer_data_v1) LIMIT 0;

-- Step 2: SCD Type 2 -- close out the current row for any key whose
-- tracked columns changed. Only rows already marked "current"
-- (to_date IS NULL) are eligible for comparison, so historical rows
-- are never touched.
MERGE `gcp-accelerator-380712.gold.dim_customer_scd2` T
USING (SELECT
  customer_data_v1.customer_id AS customer_id,
  customer_data_v1.account_balance AS account_balance,
  CURRENT_DATE() AS from_date,
  CAST(NULL AS DATE) AS to_date,
  TRUE AS is_current
FROM ${ref("customer_data_v1")} AS customer_data_v1) S
ON T.customer_id = S.customer_id
   AND T.to_date IS NULL
WHEN MATCHED AND (T.account_balance IS DISTINCT FROM S.account_balance) THEN
  UPDATE SET T.to_date = CURRENT_DATE(), T.is_current = FALSE;

-- Step 3: SCD Type 2 -- insert a new current-version row for any key
-- that is brand new, or whose previous current row was just closed
-- out by Step 2 above.
MERGE `gcp-accelerator-380712.gold.dim_customer_scd2` T
USING (SELECT
  customer_data_v1.customer_id AS customer_id,
  customer_data_v1.account_balance AS account_balance,
  CURRENT_DATE() AS from_date,
  CAST(NULL AS DATE) AS to_date,
  TRUE AS is_current
FROM ${ref("customer_data_v1")} AS customer_data_v1) S
ON T.customer_id = S.customer_id
   AND T.to_date IS NULL
WHEN NOT MATCHED THEN
  INSERT (customer_id, account_balance, from_date, to_date, is_current) VALUES (S.customer_id, S.account_balance, CURRENT_DATE(), NULL, TRUE)
