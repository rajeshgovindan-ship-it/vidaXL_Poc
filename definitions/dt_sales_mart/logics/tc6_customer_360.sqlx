config {
  type: "table",
  schema: "gold",
  tags: ["dt_sales_mart", "tc6_customer_360", "gold", "daily"],
  columns: {
    "customer_id": "Customer id -- all 7 DQ checks live here.",
    "customer_name": "Customer name.",
    "signup_timestamp": "Signup timestamp.",
    "Customer_Id": "Business customer id (string).",
    "Country": "Country.",
    "uid": "Order customer id (matches Customer_Id).",
    "total_spend": "Total spend.",
    "spend_rank_in_country": "Spend rank within country.",
    "dw_load_timestamp": "Audit: when this row was written by Dataform. -- Calculation: CURRENT_TIMESTAMP()",
    "dw_source_table": "Audit: the source table this row was derived from. -- Calculation: 'gcp-accelerator-380712.bq_data.customer_data_v1'",
    "dw_batch_date": "Audit: logical load date of the batch that wrote this row. -- Calculation: CURRENT_DATE()"
  },
  bigquery: {
    partitionBy: "DATE(signup_timestamp)",
    clusterBy: ["customer_id"],
  },
  description: "TC6: all 7 DQ + 3-CTE join + window + agg."
}

WITH customer_base AS (
  SELECT
    customer_data_v1.customer_id AS customer_id,
    customer_data_v1.customer_name AS customer_name,
    customer_data_v1.signup_timestamp AS signup_timestamp
  FROM ${ref("customer_data_v1")} AS customer_data_v1
),
customer_tags AS (
  SELECT
    customer_data_with_tags.Customer_Id AS Customer_Id,
    customer_data_with_tags.Country AS Country
  FROM ${ref("customer_data_with_tags")} AS customer_data_with_tags
),
orders_info AS (
  SELECT
    orders_data.uid AS uid,
    SUM(orders_data.amount) AS total_spend
  FROM ${ref("orders_data")} AS orders_data
  WHERE orders_data.status = 'COMPLETE'
  GROUP BY orders_data.uid
  HAVING SUM(orders_data.amount) > 0
)
SELECT
  customer_base.customer_id AS customer_id,
  customer_tags.Country AS Country,
  orders_info.total_spend AS total_spend,
  RANK() OVER (PARTITION BY Country ORDER BY total_spend DESC) AS spend_rank_in_country,
  customer_tags.Customer_Id AS customer_tags_Customer_Id,
  orders_info.uid AS uid,
  CURRENT_TIMESTAMP() AS dw_load_timestamp,
  'gcp-accelerator-380712.bq_data.customer_data_v1' AS dw_source_table,
  CURRENT_DATE() AS dw_batch_date,
  customer_base.customer_name AS customer_name,
  customer_base.signup_timestamp AS signup_timestamp
FROM customer_base AS customer_base
INNER JOIN customer_tags AS customer_tags ON customer_base.customer_id = SAFE_CAST(customer_tags.Customer_Id AS INT64)
LEFT JOIN orders_info AS orders_info ON customer_tags.Customer_Id = orders_info.uid


post_operations {
  ALTER TABLE ${self()}
  ADD PRIMARY KEY (
    customer_id
  ) NOT ENFORCED;
}
