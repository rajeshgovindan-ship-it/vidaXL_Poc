config {
  type: "assertion",
  name: "assert_customer_data_with_tags_refined_unique_key",
  description: "Uniqueness check for customer_data_with_tags_refined (Index) -- all data quality checks are generated as standalone assertion files."
}

SELECT Index, COUNT(*) AS row_count
FROM ${ref("customer_data_with_tags_refined")}
GROUP BY Index
HAVING COUNT(*) > 1
