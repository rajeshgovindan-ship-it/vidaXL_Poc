-- Idempotent via ${ref()} + Dataform incremental/operations semantics
config {
  type: "incremental",
  schema: "gold",
  uniqueKey: ["customer_id"],
  tags: ["dt_salesmart", "customer_data_v1", "gold", "daily"],
  columns: {
    customer_id: "unique key for customer details table",
    customer_name: "Name for each customer",
    email: "Customer email to send the details of updates",
    is_active: "flag to update the scd type 2",
    signup_timestamp: "date for each load",
    account_balance: "details for active balance for customer",
    tags: "tags for each column"
  },
  bigquery: {
    partitionBy: "DATE(signup_timestamp)",
    clusterBy: ["customer_id"],
  },
  description: "this table is mainly for customer details"
}

WITH customer_details_infor AS (
  SELECT
    customer_data_v1.customer_id AS customer_id,
    ROW_NUMBER() OVER (PARTITION BY DATE(signup_timestamp) ORDER BY customer_id DESC) AS rn
  FROM ${ref("customer_data_v1")} AS customer_data_v1
  WHERE account_balance>100
)
SELECT
  customer_details_infor.customer_name AS customer_name,
  customer_details_infor.email AS email,
  customer_details_infor.is_active AS is_active,
  customer_details_infor.signup_timestamp AS signup_timestamp,
  customer_details_infor.account_balance AS account_balance,
  customer_details_infor.tags AS tags
FROM customer_details_infor AS customer_details_infor


post_operations {
  ${when(!incremental(),
    `ALTER TABLE ${self()}
    ADD PRIMARY KEY (
      customer_id
    ) NOT ENFORCED`
  )}
}
