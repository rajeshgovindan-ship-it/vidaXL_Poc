}

WITH customer_details AS (
  SELECT
    ROW_NUMBER() OVER (PARTITION BY Subscription_Date ORDER BY Subscription_Date DESC) AS Index
  FROM ${ref("customer_data_with_tags")} AS customer_data_with_tags
)
SELECT
  customer_details.Customer_Id AS Customer_Id,
  customer_details.First_Name AS First_Name,
  customer_details.Last_Name AS Last_Name,
  customer_details.Company AS Company,
  customer_details.City AS City,
  customer_details.Country AS Country,
  customer_details.Phone_1 AS Phone_1,
  customer_details.Phone_2 AS Phone_2,
  customer_details.Email AS Email,
  customer_details.Subscription_Date AS Subscription_Date,
  customer_details.Website AS Website
FROM customer_details AS customer_details


post_operations {
  ${when(!incremental(),
    `ALTER TABLE ${self()}
    ADD PRIMARY KEY (
      Customer_Id,
      Country
    ) NOT ENFORCED`
  )}
