-- Generated by vidaXL Fabric Accelerator (Dataform edition)
-- Target: gcp-accelerator-380712.gold.fct_orders
-- Tags: dt_salesmart, fct_orders, gold, daily
-- Idempotent via ${ref()} + Dataform incremental/operations semantics
config {
  type: "incremental",
  schema: "gold",
  uniqueKey: ["order_id"],
  tags: ["dt_salesmart", "fct_orders", "gold", "daily"],
  columns: {
    order_id: "Unique order identifier.",
    uid: "Customer id.",
    amount: "Order value.",
    status: "Order status.",
    order_date: "Order date (DATE).",
    customer_country: "Customer country from the customer dimension."
  },
  bigquery: {
    partitionBy: "order_date",
    partitionExpirationDays: 1095,
    clusterBy: ["uid", "status"],
    updatePartitionFilter: "order_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)",
  },
  description: "Order fact - deduplicated, enriched with customer country."
}

WITH orders_ranked AS (
  SELECT
    orders_data.order_id AS order_id,
    orders_data.uid AS uid,
    orders_data.amount AS amount,
    orders_data.status AS status,
    PARSE_DATE('%Y-%m-%d', order_date) AS order_date
  FROM ${ref("orders_data")} AS orders_data
  WHERE status IS NOT NULL
  QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY order_date DESC) = 1
)
SELECT
  orders_ranked.order_id AS order_id,
  orders_ranked.order_date AS order_date,
  orders_ranked.uid AS uid,
  orders_ranked.amount AS amount,
  orders_ranked.status AS status,
  dim_customer_tags.Country AS customer_country
FROM orders_ranked AS orders_ranked
LEFT JOIN ${ref("dim_customer_tags")} AS dim_customer_tags ON orders_ranked.uid = dim_customer_tags.Customer_Id
${when(incremental(),
  `WHERE order_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 3 DAY)`
)}


post_operations {
  ${when(!incremental(),
    `ALTER TABLE ${self()}
    ADD PRIMARY KEY (
      order_id
    ) NOT ENFORCED`
  )}
}
