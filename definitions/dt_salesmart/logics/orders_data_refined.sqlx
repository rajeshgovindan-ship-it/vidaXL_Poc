-- Generated by vidaXL Fabric Accelerator (Dataform edition)
-- Target: gcp-accelerator-380712.gold.orders_data_refined
-- Tags: dt_salesmart, gold, daily
-- Idempotent via ${ref()} + Dataform incremental/operations semantics
config {
  type: "incremental",
  schema: "gold",
  uniqueKey: ["order_id"],
  tags: ["dt_salesmart", "gold", "daily"],
  columns: {
    order_id: "unique_id of order number",
    order_date: "product name which order customer",
    uid: "unique order id",
    amount: "amount of the order",
    status: "status of the order"
  },
  description: "order information details provided by vidaxl"
}

WITH order_details_items AS (
  SELECT
    orders_data.order_id AS order_id,
    RANK() OVER (PARTITION BY Date(order_date) ORDER BY amount DESC) AS rnk,
    orders_data.order_date AS order_date,
    orders_data.uid AS uid,
    orders_data.amount AS amount,
    orders_data.status AS status
  FROM ${ref("orders_data")} AS orders_data
  WHERE amount>100
)
SELECT
  order_details_items.order_date AS order_date,
  order_details_items.uid AS uid,
  order_details_items.amount AS amount,
  order_details_items.status AS status,
  order_details_items.order_id AS order_id
FROM order_details_items AS order_details_items


post_operations {
  ${when(!incremental(),
    `ALTER TABLE ${self()}
    ADD PRIMARY KEY (
      order_id
    ) NOT ENFORCED`
  )}
}
