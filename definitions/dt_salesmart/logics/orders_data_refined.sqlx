WITH customer_orders AS (
  SELECT
    orders_data.order_id AS order_id,
    COUNT(*) AS order_count,
    SUM(amount) AS total_amount, AS total_amount,
    AVG(amount) AS avg_amount
  FROM ${ref("orders_data")} AS orders_data
  WHERE orders_data.status = 'COMPLETED'
  GROUP BY orders_data.order_id
  HAVING COUNT(*) >= 2
)
SELECT
  customer_orders.order_id AS order_id,
  customer_orders.total_amount AS total_amount,
  customer_orders.avg_amount AS avg_amount
FROM customer_orders AS customer_orders
