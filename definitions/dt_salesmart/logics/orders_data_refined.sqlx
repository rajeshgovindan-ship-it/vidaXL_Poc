-- Generated by Tiger Data Fabric (Dataform edition)
-- Target: gcp-accelerator-380712.gold.orders_data_refined
-- Tags: dt_salesmart, gold, daily
-- Idempotent via ${ref()} + Dataform incremental/operations semantics
config {
  type: "incremental",
  schema: "gold",
  uniqueKey: ["order_id", "order_id"],
  tags: ["dt_salesmart", "gold", "daily"],
  columns: {
    order_id: "unique order_id",
    order_date: "order name",
    uid: "order unique id for scd2",
    amount: "order amount",
    status: "order status"
  },
  description: "this only table to have orders details"
}

WITH order_information AS (
  SELECT
    orders_data.order_id AS order_id,
    ROW_NUMBER() OVER (PARTITION BY Date(order_date) ORDER BY amount DESC) AS rn,
    orders_data.order_date AS order_date,
    orders_data.uid AS uid,
    orders_data.amount AS amount,
    orders_data.status AS status
  FROM ${ref("orders_data")} AS orders_data
  WHERE amount>100
  QUALIFY rn=1
)
SELECT
  order_information.order_date AS order_date,
  order_information.uid AS uid,
  order_information.amount AS amount,
  order_information.status AS status,
  order_information.order_id AS order_id
FROM order_information AS order_information
WHERE rn=1


post_operations {
  ${when(!incremental(),
    `ALTER TABLE ${self()}
    ADD PRIMARY KEY (
      order_id,
      order_id
    ) NOT ENFORCED`
  )}
}
