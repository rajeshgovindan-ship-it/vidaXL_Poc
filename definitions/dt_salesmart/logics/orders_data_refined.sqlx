WITH orders_details AS (
  SELECT
    orders_data.order_id AS order_id,
    ROW_NUMBER() OVER (PARTITION BY Date(order_date) ORDER BY amount DESC) AS rn,
    orders_data.order_date AS order_date,
    orders_data.uid AS uid,
    orders_data.amount AS amount,
    orders_data.status AS status
  FROM ${ref("orders_data")} AS orders_data
  WHERE amount>100
  QUALIFY rn=1
)
SELECT
  orders_details.order_date AS order_date,
  orders_details.uid AS uid,
  orders_details.amount AS amount,
  orders_details.status AS status
FROM orders_details AS orders_details


post_operations {
  ${when(!incremental(),
    `ALTER TABLE ${self()}
    ADD PRIMARY KEY (
      order_id
    ) NOT ENFORCED`
  )}
}
