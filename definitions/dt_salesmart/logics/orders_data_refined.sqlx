config {
  type: "incremental",
  schema: "gold",
  uniqueKey: ["order_id", "order_date", "uid"],
  tags: ["dt_salesmart", "orders_data_refined", "gold", "daily"],
  columns: {
    order_id: "order id is mere number which is used to get not null value",
    order_date: "order name who is ordering the product",
    uid: "unique number which is used to identify the common record",
    amount: "price of the product",
    status: "status of the order"
  },
  bigquery: {
    partitionBy: "DATE(order_date)",
    clusterBy: ["order_id", "status"],
  },
  description: "complete order details will get from the table"
}

WITH orders_details AS (
  SELECT
    ROW_NUMBER() OVER (PARTITION BY DATE(order_date) ORDER BY amount DESC) AS order_id
  FROM ${ref("orders_data")} AS orders_data
  WHERE amount>100
)
SELECT
  orders_details.order_date AS order_date,
  orders_details.uid AS uid,
  orders_details.amount AS amount,
  orders_details.status AS status
FROM orders_details AS orders_details


post_operations {
  ${when(!incremental(),
    `ALTER TABLE ${self()}
    ADD PRIMARY KEY (
      order_id,
      order_date,
      uid
    ) NOT ENFORCED`
  )}
}
