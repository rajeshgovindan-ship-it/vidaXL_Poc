-- Target: gcp-accelerator-380712.gold.tc3_country_revenue
-- Tags: dt_salesmart, tc3_country_revenue, gold, daily
-- Idempotent via ${ref()} + Dataform incremental/operations semantics
config {
  type: "view",
  schema: "gold",
  tags: ["dt_salesmart", "tc3_country_revenue", "gold", "daily"],
  columns: {
    "country": "Country.",
    "revenue": "Total revenue. -- Calculation: SUM(amount)",
    "order_cnt": "Order count. -- Calculation: COUNT(DISTINCT order_id)"
  },
  description: "TC3 LEFT JOIN + GROUP BY + HAVING."
}

SELECT
  customer_data_with_tags.Country AS country,
  SUM(amount) AS revenue,
  COUNT(DISTINCT order_id) AS order_cnt
FROM ${ref("customer_data_with_tags")} AS customer_data_with_tags
LEFT JOIN ${ref("orders_data")} AS orders_data ON customer_data_with_tags.Customer_Id = orders_data.uid
GROUP BY customer_data_with_tags.Country
HAVING SUM(amount) > 0
ORDER BY revenue DESC
