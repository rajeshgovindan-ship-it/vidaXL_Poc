-- Generated by vidaXL Fabric Accelerator (Dataform edition)
-- Target: gcp-accelerator-380712.gold.tc4_customer_spend_rank
-- Tags: dt_salesmart, tc4_customer_spend_rank, gold, daily
-- Idempotent via ${ref()} + Dataform incremental/operations semantics
config {
  type: "incremental",
  schema: "gold",
  uniqueKey: ["uid"],
  tags: ["dt_salesmart", "tc4_customer_spend_rank", "gold", "daily"],
  columns: {
    "order_id": "Order id.",
    "uid": "Customer id.",
    "amount": "Amount.",
    "status": "Status.",
    "order_date": "Order date (DATE). -- Calculation: PARSE_DATE('%Y-%m-%d', order_date)",
    "total_spend": "Spend.",
    "order_cnt": "Orders.",
    "last_order_date": "Last order date.",
    "country": "Country.",
    "spend_rank": "Rank.",
    "spend_tier": "Tier."
  },
  bigquery: {
    partitionBy: "last_order_date",
    partitionExpirationDays: 1095,
    clusterBy: ["country", "uid"],
    updatePartitionFilter: "last_order_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 14 DAY)",
  },
  description: "TC4 3 CTEs + JOIN + RANK."
}

WITH clean_orders AS (
  SELECT
    orders_data.order_id AS order_id,
    orders_data.uid AS uid,
    orders_data.amount AS amount,
    orders_data.status AS status,
    PARSE_DATE('%Y-%m-%d', order_date) AS order_date
  FROM ${ref("orders_data")} AS orders_data
  WHERE status IS NOT NULL AND amount > 0
  QUALIFY ROW_NUMBER() OVER (PARTITION BY order_id ORDER BY order_date DESC) = 1
),
totals AS (
  SELECT
    clean_orders.uid AS uid,
    SUM(amount) AS total_spend,
    COUNT(DISTINCT order_id) AS order_cnt,
    MAX(order_date) AS last_order_date
  FROM clean_orders AS clean_orders
  GROUP BY clean_orders.uid
  HAVING SUM(amount) > 0
),
ranked AS (
  SELECT
    totals.uid AS uid,
    totals.total_spend AS total_spend,
    totals.order_cnt AS order_cnt,
    totals.last_order_date AS last_order_date,
    customer_data_with_tags.Country AS country,
    RANK() OVER (PARTITION BY country ORDER BY total_spend DESC) AS spend_rank,
    DENSE_RANK() OVER (PARTITION BY country ORDER BY total_spend DESC) AS spend_tier
  FROM totals AS totals
  LEFT JOIN ${ref("customer_data_with_tags")} AS customer_data_with_tags ON totals.uid = customer_data_with_tags.Customer_Id
)
SELECT
  ranked.uid AS uid,
  ranked.country AS country,
  ranked.total_spend AS total_spend,
  ranked.order_cnt AS order_cnt,
  ranked.last_order_date AS last_order_date,
  ranked.spend_rank AS spend_rank,
  ranked.spend_tier AS spend_tier
FROM ranked AS ranked
WHERE spend_rank <= 100
${when(incremental(),
  `AND last_order_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)`
)}


post_operations {
  ${when(!incremental(),
    `ALTER TABLE ${self()}
    ADD PRIMARY KEY (
      uid
    ) NOT ENFORCED`
  )}
}
