-- Generated by vidaXL Fabric Accelerator (Dataform edition)
-- Target: gcp-accelerator-380712.gold.tc5_customer_latest
-- Tags: dt_salesmart, tc5_customer_latest, gold, daily
-- Idempotent via ${ref()} + Dataform incremental/operations semantics
config {
  type: "incremental",
  schema: "gold",
  uniqueKey: ["Customer_Id"],
  tags: ["dt_salesmart", "tc5_customer_latest", "gold", "daily"],
  columns: {
    Customer_Id: "Customer id.",
    First_Name: "First name.",
    Last_Name: "Last name.",
    Company: "Company.",
    City: "City.",
    Country: "Country.",
    Email: "Email.",
    Subscription_Date: "Sub date."
  },
  bigquery: {
    partitionBy: "Subscription_Date",
    partitionExpirationDays: 1095,
    clusterBy: ["Country", "City"],
  },
  description: "TC5 INCREMENTAL + QUALIFY dedup."
}

SELECT
  customer_data_with_tags.Customer_Id AS Customer_Id,
  customer_data_with_tags.First_Name AS First_Name,
  customer_data_with_tags.Last_Name AS Last_Name,
  customer_data_with_tags.Company AS Company,
  customer_data_with_tags.City AS City,
  customer_data_with_tags.Country AS Country,
  customer_data_with_tags.Email AS Email,
  customer_data_with_tags.Subscription_Date AS Subscription_Date
FROM ${ref("customer_data_with_tags")} AS customer_data_with_tags
${when(incremental(),
  `WHERE Subscription_Date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)`
)}
QUALIFY ROW_NUMBER() OVER (PARTITION BY Customer_Id ORDER BY Subscription_Date DESC) = 1


post_operations {
  ${when(!incremental(),
    `ALTER TABLE ${self()}
    ADD PRIMARY KEY (
      Customer_Id
    ) NOT ENFORCED`
  )}
}
