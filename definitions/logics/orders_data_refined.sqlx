WITH customer_orders  AS (
  SELECT
    COUNT(*) AS order_count, AS uid,
    orders_data.amount AS amount,
    orders_data.status AS status
  FROM ${ref("orders_data")} AS orders_data
  WHERE status = 'COMPLETED'
  GROUP BY orders_data.amount, orders_data.status
  HAVING COUNT(*) >= 2
)
SELECT
  customer_orders.amount AS amount,
  SUM(amount) AS total_amount,AVG(amount) AS avg_amount,
  customer_orders.status AS status,
  customer_orders.uid AS uid
FROM `customer_orders` AS customer_orders
WHERE status = 'COMPLETED'
GROUP BY customer_orders.amount, customer_orders.status, customer_orders.uid
