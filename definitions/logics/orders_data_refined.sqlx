CREATE OR REPLACE TABLE `gcp-accelerator-380712.gold.orders_data_refined`
PARTITION BY
  order_date
CLUSTER BY
  order_id, status
AS 
WITH order_qty AS (
  SELECT
    orders_data.order_id DENSE_RANK() OVER (PARTITION BY order_date ORDER BY order_id,status DESC) AS order_id
  FROM ${ref("orders_data")} AS orders_data
  WHERE amount>5000
)
SELECT
  orders_data.order_date AS order_date
FROM ${ref("orders_data")} AS orders_data
